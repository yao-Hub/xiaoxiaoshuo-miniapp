<view wx:if="{{!hidden}}" class="tab-bar {{theme === 'light' ? 'theme-light' : 'theme-dark'}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    {{item.text}}
  </view>
</view>
