.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding: 0 72rpx env(safe-area-inset-bottom);
  background: #181714;
  border-top: 1px solid rgba(245, 237, 220, 0.12);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 104rpx;
  color: #a9a195;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
}

.tab-item.active {
  color: #f5c84c;
  font-weight: 700;
}
